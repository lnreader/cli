{
  "name": "@lnreader/plugin-runtime",
  "version": "0.0.0",
  "description": "Run LNReader plugins in Node and build EPUBs from them",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnreader/cli.git",
    "directory": "packages/plugin-runtime"
  },
  "homepage": "https://github.com/lnreader/cli/tree/main/packages/plugin-runtime#readme",
  "bugs": {
    "url": "https://github.com/lnreader/cli/issues"
  },
  "keywords": [
    "lnreader",
    "light-novel",
    "web-novel",
    "plugin",
    "epub",
    "scraper"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "env-paths": "^4.0.0",
    "htmlparser2": "^9.1.0",
    "jszip": "^3.10.2",
    "protobufjs": "^7.6.6",
    "sanitize-html": "^2.17.7",
    "tough-cookie": "^6.0.2",
    "turndown": "^7.2.4",
    "urlencode": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@types/urlencode": "^2.0.0"
  }
}
